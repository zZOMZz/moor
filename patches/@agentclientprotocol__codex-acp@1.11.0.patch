diff --git a/dist/moor.js b/dist/moor.js
new file mode 100644
index 0000000000000000000000000000000000000000..7fa4b918efc8fc9f0dd9394cf44a794d2f1f9fbe
--- /dev/null
+++ b/dist/moor.js
@@ -0,0 +1,92 @@
+// Moor extension v1 for @agentclientprotocol/codex-acp 1.11.0 (Apache-2.0).
+// Read-only account telemetry and explicit permission presets; no prompt dispatch.
+import { createHash } from 'node:crypto';
+
+export const MOOR_USAGE_READ = '_moor/account/rate_limits/read';
+export const MOOR_USAGE_UPDATED = '_moor/account/rate_limits/updated';
+export const MOOR_CAPABILITIES = {
+  version: 1,
+  modelCatalog: true,
+  approvalModes: true,
+  rateLimits: { read: MOOR_USAGE_READ, updated: MOOR_USAGE_UPDATED },
+};
+
+export function moorModes(Mode) {
+  return [
+    new Mode('moor-read-only', 'Read-only', 'Read files; ask the user when elevated access is needed.', 'read_only', 'on-request', 'user', { type: 'readOnly' }, 'read-only'),
+    new Mode('moor-agent', 'Agent', 'Work in the workspace; ask the user when approval is needed.', 'standard', 'on-request', 'user', Mode.ReadOnly.sandboxPolicy, 'workspace-write'),
+    new Mode('moor-auto-review', 'Auto review', 'Work in the workspace; Codex reviews approval requests.', 'auto_review', 'on-request', 'auto_review', Mode.Agent.sandboxPolicy, 'workspace-write'),
+    new Mode('moor-full-access', 'Full access', 'Access files and the network without requesting approval.', 'full_access', 'never', 'user', { type: 'dangerFullAccess' }, 'danger-full-access'),
+  ];
+}
+
+export function moorModelMetadata(model) {
+  return { moor: {
+    version: 1,
+    efforts: model.supportedReasoningEfforts.map(option => option.reasoningEffort),
+    defaultEffort: model.defaultReasoningEffort,
+  } };
+}
+
+export class MoorRateLimits {
+  epoch = 0;
+  sequence = 0;
+  supported = false;
+  accountKey;
+  constructor(server) {
+    this.server = server;
+    server.codexAcpClient.appServerClient.onClientTransportEvent(event => {
+      if (event.eventType !== 'notification') return;
+      if (event.method === 'account/updated') {
+        this.epoch++;
+        this.accountKey = undefined;
+        this.publish({ version: 1, status: 'unknown', sequence: ++this.sequence });
+        if (this.supported) void this.read().then(value => this.publish(value)).catch(() => {});
+      } else if (event.method === 'account/rateLimits/updated' && this.accountKey) {
+        this.publish({ version: 1, status: 'ready', accountKey: this.accountKey,
+          sequence: ++this.sequence, partial: true, rateLimits: event.params.rateLimits });
+      }
+    });
+  }
+  observeAccount(account, announce = true) {
+    const identity = account?.id ?? account?.accountId ?? account?.email;
+    const next = account?.type === 'chatgpt' && typeof identity === 'string' && identity
+      ? createHash('sha256').update(identity).digest('hex') : undefined;
+    if (this.accountKey && next !== this.accountKey) {
+      this.epoch++;
+      this.publish({ version: 1, status: 'unknown', sequence: ++this.sequence });
+    }
+    this.accountKey = next;
+    if (announce && next) this.publish({ version: 1, status: 'unknown', accountKey: next, sequence: ++this.sequence });
+  }
+  publish(value) {
+    if (this.supported) void this.server.connection.notify(MOOR_USAGE_UPDATED, value).catch(() => {});
+  }
+  async read() {
+    if (!this.supported) throw new Error('Moor usage extension was not negotiated');
+    let epoch = this.epoch;
+    return this.server.runWithProcessCheck(async () => {
+      const { account } = await this.server.codexAcpClient.getAccount();
+      if (epoch !== this.epoch) throw new Error('Account changed during usage read');
+      if (!account || account.type !== 'chatgpt') {
+        this.accountKey = undefined;
+        return { version: 1, sequence: ++this.sequence, status: account ? 'unsupported' : 'signed-out' };
+      }
+      // Only an opaque identity leaves the adapter. Never publish email or auth tokens.
+      const identity = account.id ?? account.accountId ?? account.email;
+      if (typeof identity !== 'string' || !identity) throw new Error('Account identity unavailable');
+      this.observeAccount(account, false);
+      epoch = this.epoch;
+      let result;
+      try { result = await this.server.codexAcpClient.getRateLimits(); }
+      catch {
+        if (epoch !== this.epoch) throw new Error('Account changed during usage read');
+        return { version: 1, status: 'failed', accountKey: this.accountKey, sequence: ++this.sequence };
+      }
+      if (epoch !== this.epoch) throw new Error('Account changed during usage read');
+      return { version: 1, status: 'ready', accountKey: this.accountKey,
+        sequence: ++this.sequence, partial: false,
+        rateLimits: result.rateLimits, rateLimitsByLimitId: result.rateLimitsByLimitId };
+    });
+  }
+}
