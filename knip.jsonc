{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/build/*.mjs",
        "scripts/release/*.mjs",
        "scripts/validation/{test,synthetic-agent}.mjs",
        "scripts/validation/check-*.mjs",
        "scripts/validation/prepare-validation.ts",
        "tests/**/*.test.ts",
        "tests/e2e/*.cjs",
        "tests/fixtures/synthetic-*.mjs",
        "tests/fixtures/vite-desktop.cjs",
        "tests/fixtures/workspace-layout-fixture.tsx",
        "tests/fixtures/performance-panel-fixture.ts",
        "tests/fixtures/streaming-*.{ts,tsx}",
      ],
      "project": ["scripts/**/*.{ts,tsx,js,cjs,mjs}", "tests/**/*.{ts,tsx,js,cjs,mjs}"],
      // Node test bundles resolve one external CRDT/WASM runtime from the root.
      "ignoreDependencies": ["@agentclientprotocol/codex-acp", "loro-crdt"],
    },
    "packages/protocol": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "packages/session": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "packages/client": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "apps/cli": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "packages/gateway": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "apps/relay": {
      "entry": ["src/main.ts!", "tests/**/*.test.ts"],
      "project": ["src/**/*.{ts,d.ts}!", "tests/**/*.ts"],
    },
    "packages/host": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
      "ignoreDependencies": ["@agentclientprotocol/codex-acp!"],
    },
    "apps/host": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
    },
    "apps/web": {
      "entry": [
        "src/features/notifications/notification-worker.ts!",
        "public/{startup,sw}.js!",
        "src/styles/*.css!",
        "public/style.css!",
        "tests/**/*.test.ts",
      ],
      "project": ["src/**/*.{ts,tsx,css}!", "public/*.{js,css}!", "tests/**/*.ts"],
      "paths": {
        "__ENTRY__": ["./src/app/entry.ts"],
      },
    },
    "apps/desktop": {
      "entry": [
        "src/main/main.cjs!",
        "src/main/workspace-client-entry.ts!",
        "src/preload/*.cjs!",
        "src/settings/settings.js!",
        "tests/**/*.test.ts",
      ],
      "project": ["src/**/*.{ts,js,cjs}!", "tests/**/*.ts"],
    },
    "packages/sync": {
      "project": ["src/**/*.ts!"],
    },
  },
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["ditto", "mkfifo"],
  "rules": {
    "exports": "error",
    "types": "error",
    "enumMembers": "warn",
    "namespaceMembers": "warn",
  },
  "tags": ["-nativeEntry"],
}
