{
  "name": "@moor/app-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./dist/main.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build/build-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @moor/app-cli... run build && node ../../scripts/validation/test.mjs apps/cli"
  },
  "dependencies": {
    "@moor/client": "workspace:*",
    "@moor/protocol": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
