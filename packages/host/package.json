{
  "name": "@moor/host",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build/build-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @moor/host... run build && node ../../scripts/validation/test.mjs packages/host"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.11.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@moor/e2ee": "workspace:*",
    "@moor/protocol": "workspace:*",
    "@moor/session": "workspace:*",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
