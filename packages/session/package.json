{
  "name": "@moor/session",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build/build-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "pnpm --filter @moor/session... run build && node ../../scripts/validation/test.mjs packages/session"
  },
  "dependencies": {
    "@loro-dev/flock-wasm": "0.4.3",
    "@moor/protocol": "workspace:*",
    "loro-crdt": "1.15.1",
    "loro-mirror": "2.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
