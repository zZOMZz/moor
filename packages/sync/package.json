{
  "name": "@moor/sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapters/sqlite": {
      "types": "./src/adapters/sqlite.ts",
      "import": "./dist/adapters/sqlite.js"
    },
    "./document/documents": {
      "types": "./src/document/documents.ts",
      "import": "./dist/document/documents.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build/build-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "pnpm --filter @moor/sync... run build && node ../../scripts/validation/test.mjs packages/sync"
  },
  "dependencies": {
    "@moor/protocol": "workspace:*",
    "@moor/session": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
