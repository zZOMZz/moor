{
  "name": "moor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:workspaces && node scripts/build/build.mjs",
    "build:workspaces": "pnpm --filter './packages/*' --filter './apps/*' --if-present run build",
    "start": "node dist/server.mjs",
    "bridge": "node dist/bridge.mjs",
    "cli": "node dist/cli.mjs",
    "security": "node dist/security.mjs",
    "dev": "tsx apps/relay/src/main.ts",
    "deploy:check": "node scripts/release/deploy-relay.mjs check",
    "deploy:relay": "node scripts/release/deploy-relay.mjs deploy",
    "check": "pnpm check:workspaces && tsc --noEmit && pnpm boundaries && pnpm docs:check",
    "check:workspaces": "pnpm --filter './packages/*' --filter './apps/*' --if-present run check",
    "boundaries": "node scripts/validation/check-package-boundaries.mjs",
    "docs:check": "node scripts/validation/check-doc-links.mjs",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "pnpm build:workspaces && node scripts/validation/test.mjs",
    "package:relay": "npm run build && node scripts/release/package.mjs relay",
    "package:mac": "npm run build && node scripts/release/package.mjs mac",
    "format": "prettier --write apps packages scripts tests deploy docs package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json knip.jsonc README.md AGENTS.md",
    "format:check": "prettier --check apps packages scripts tests deploy docs package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json knip.jsonc README.md AGENTS.md"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "1.11.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@loro-dev/flock-wasm": "0.4.3",
    "@moor/client": "workspace:*",
    "@moor/e2ee": "workspace:*",
    "@moor/gateway": "workspace:*",
    "@moor/host": "workspace:*",
    "@moor/protocol": "workspace:*",
    "@moor/session": "workspace:*",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "jsdom": "30.0.1",
    "jose": "6.2.12",
    "knip": "6.35.1",
    "loro-crdt": "1.15.1",
    "prettier": "3.7.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "electron": "44.3.0",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "packageManager": "pnpm@10.20.0",
  "description": "Local-first coding agents, reachable from your own devices",
  "license": "Apache-2.0"
}
